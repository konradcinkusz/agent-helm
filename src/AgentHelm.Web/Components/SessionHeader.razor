<div class="session-head">
    <div class="session-head-main">
        @if (EditingTitle)
        {
            <input class="title-input" value="@TitleDraft" @oninput="TitleInputAsync"
                   @onkeydown="e => OnTitleKey.InvokeAsync(e)" />
        }
        else
        {
            <div class="session-head-title" title="@Session.Title">@Session.Title</div>
        }
        <div class="session-head-sub">
            <span>@RepoName()</span> · <span title="@Session.Cwd">@Session.Cwd</span>@ModelSuffix()
            @if (Session.Caps is { } caps)
            {
                @if (caps.LoadSession) { <span class="cap-chip">resume</span> }
                @if (caps.Image) { <span class="cap-chip">images</span> }
                @if (caps.EmbeddedContext) { <span class="cap-chip">files</span> }
            }
        </div>
    </div>
    <div class="session-head-actions">
        <span class="mode-chip" title="Permission mode — set under the composer">@ModeLabel()</span>
        <span class="status @Session.Status">@Session.Status</span>
        <button class="btn toggle @(ActiveTab == "changes" ? "on" : "")" aria-pressed="@(ActiveTab == "changes" ? "true" : "false")"
                @onclick='() => OnSwitchTab.InvokeAsync(ActiveTab == "changes" ? "chat" : "changes")'>Changes</button>
        <button class="btn toggle @(ActiveTab == "terminal" ? "on" : "")" aria-pressed="@(ActiveTab == "terminal" ? "true" : "false")"
                @onclick='() => OnSwitchTab.InvokeAsync(ActiveTab == "terminal" ? "chat" : "terminal")'>Terminal</button>
        <button class="btn" @onclick="() => OnStop.InvokeAsync()" disabled="@(Session.Status != "running")">Stop</button>
        <div class="head-menu">
            <button class="btn icon" title="Session actions" aria-haspopup="menu" aria-expanded="@(_menuOpen ? "true" : "false")"
                    @onclick="() => _menuOpen = !_menuOpen">⋯</button>
            @if (_menuOpen)
            {
                <div class="head-menu-list" role="menu">
                    <button class="menu-item" role="menuitem" @onclick="() => RunAsync(OnStartEditTitle)">Rename</button>
                    <button class="menu-item" role="menuitem" title="Quality scores from CopilotScope (time-based match)"
                            @onclick="() => RunAsync(OnToggleScope)">Scope</button>
                    <button class="menu-item" role="menuitem" title="Continue this conversation with a different agent"
                            @onclick="() => RunAsync(OnToggleHandoff)">Handoff</button>
                    <button class="menu-item danger" role="menuitem" @onclick="() => RunAsync(OnDelete)">Delete</button>
                </div>
            }
        </div>
    </div>
</div>
