<aside class="rail @(_collapsed ? "collapsed" : "")">
    <div class="rail-top">
        <button class="btn rail-toggle" title="@(_collapsed ? "Expand sidebar" : "Collapse sidebar")"
                aria-expanded="@(!_collapsed)" @onclick="ToggleCollapsed">@(_collapsed ? "»" : "«")</button>
    </div>
    <nav class="rail-nav">
        <a class="rail-nav-item" href="/" title="My work">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
            <span class="rail-nav-label">My work</span>
        </a>
        <button class="rail-nav-item" disabled title="Coming soon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
            <span class="rail-nav-label">Search</span>
        </button>
        <a class="rail-nav-item" href="#chats" title="Chats">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
            <span class="rail-nav-label">Chats</span>
        </a>
    </nav>
    <div class="rail-head">
        <span class="rail-label">@(ShowHistory ? "History" : "Sessions")</span>
        <div class="rail-actions">
            <button class="btn" @onclick="() => OnToggleHistory.InvokeAsync()">@(ShowHistory ? "Live" : "History")</button>
            @if (!ShowHistory)
            {
                <button class="btn new-btn" title="New session" aria-label="New session" @onclick="() => OnToggleNewSession.InvokeAsync()">+</button>
            }
        </div>
    </div>

    @if (!ShowHistory)
    {
        @if (ShowNewSession)
        {
            <div class="new-session">
                <select value="@NewAgentId" @onchange="NewAgentChangedAsync">
                    @foreach (var agent in Agents)
                    {
                        <option value="@agent.Id">@agent.Name</option>
                    }
                </select>
                <div class="cwd-row">
                    <input class="cwd-input" placeholder="Working directory (repo path)" value="@NewCwd" @onchange="CwdChangedAsync" />
                    <button class="btn cwd-browse" title="Browse directories" @onclick="() => OnBrowse.InvokeAsync()">📁</button>
                </div>
                <div class="term-note">Path on the Bridge server. Docker users: add <code>volumes:</code> to docker-compose (e.g. <code>- C:\Repos:/repos</code>) and enter the container path here.</div>
                <input placeholder="Title (optional)" value="@NewTitle" @onchange="TitleChangedAsync" />
                @if (NewAgentModels.Count > 0)
                {
                    <select value="@NewModel" @onchange="ModelChangedAsync" title="Model for this session">
                        @foreach (var m in NewAgentModels)
                        {
                            <option value="@m.Id">@m.Name@(m.IsDefault ? " (default)" : "")</option>
                        }
                    </select>
                }
                else
                {
                    <input placeholder="Model (optional)" value="@NewModel" @onchange="ModelChangedAsync" />
                }
                <button class="btn preconfig-toggle @(ShowPreconfig ? "active" : "")"
                        @onclick="() => OnTogglePreconfig.InvokeAsync()">⚙ Pre-config</button>
                @if (ShowPreconfig)
                {
                    <div class="preconfig-panel">
                        <label class="preconfig-label">OTel endpoint <span class="preconfig-hint">(GitHub Copilot / CopilotScope)</span></label>
                        <input placeholder="http://localhost:4318" value="@PreconfigOtelUrl" @onchange="OtelUrlChangedAsync" />
                        <div class="term-note">Where the agent exports telemetry. Applied when starting the session.</div>
                    </div>
                }
                <button class="btn primary" disabled="@(Creating || string.IsNullOrWhiteSpace(NewCwd))"
                        @onclick="() => OnCreate.InvokeAsync()">
                    @(Creating ? "Starting…" : "Start session")
                </button>
                @if (CreateError is not null)
                {
                    <div class="error-note">@CreateError</div>
                }
            </div>
        }

        @foreach (var group in GroupByRepo())
        {
            <SessionGroup Name="@group.Repo" Count="@group.Sessions.Count" Expanded="@IsExpanded(group.Repo)"
                          OnToggle="@(() => ToggleGroup(group.Repo))">
                @foreach (var session in group.Sessions)
                {
                    <button class="session-card @(session.Id == SelectedId ? "active" : "")"
                            @onclick="() => OnSelectSession.InvokeAsync(session.Id)">
                        <span class="session-row">
                            <span class="status-dot status-@session.Status" title="@session.Status"></span>
                            <span class="session-title">@session.Title</span>
                            @if (session.HasPendingPermission)
                            {
                                <span class="permission-badge" title="Waiting for your permission">⏳</span>
                            }
                        </span>
                        <span class="session-meta">@session.AgentId · @PolicyLabel(session.Policy)</span>
                    </button>
                }
            </SessionGroup>
        }
        @if (!ProjectSessions.Any() && !ShowNewSession)
        {
            <div class="empty">No sessions yet.<br />Start one — the built-in <b>echo</b> agent works without any real agent installed.</div>
        }

        <div id="chats" class="rail-head chats-head">
            <span class="rail-label">Chats</span>
            <div class="rail-actions">
                <button class="btn new-btn" title="New chat" aria-label="New chat" disabled="@CreatingChat"
                        @onclick="() => OnNewChat.InvokeAsync()">+</button>
            </div>
        </div>
        @foreach (var chat in ChatSessions)
        {
            <button class="session-card @(chat.Id == SelectedId ? "active" : "")"
                    @onclick="() => OnSelectSession.InvokeAsync(chat.Id)">
                <span class="session-row">
                    <span class="status-dot status-@chat.Status" title="@chat.Status"></span>
                    <span class="session-title">@chat.Title</span>
                    @if (chat.HasPendingPermission)
                    {
                        <span class="permission-badge" title="Waiting for your permission">⏳</span>
                    }
                </span>
                <span class="session-meta">@chat.AgentId · @PolicyLabel(chat.Policy)</span>
            </button>
        }
        @if (!ChatSessions.Any())
        {
            <div class="empty">No chats yet. A quick chat needs no repository.</div>
        }
        @if (ChatError is not null)
        {
            <div class="error-note">@ChatError</div>
        }
    }
    else
    {
        @foreach (var archived in History)
        {
            <button class="session-card @(archived.Id == ArchivedId ? "active" : "")"
                    @onclick="() => OnSelectArchived.InvokeAsync(archived)">
                <span class="session-title">@archived.Title</span>
                <span class="session-meta">@archived.AgentId · @archived.LastActivity.LocalDateTime.ToString("MMM d, HH:mm")</span>
            </button>
        }
        @if (History.Count == 0)
        {
            <div class="empty">No archived sessions.<br />History requires Postgres (run via the AppHost).</div>
        }
    }

    <footer class="rail-foot">
        <a class="rail-nav-item" href="/settings" title="Providers">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" /></svg>
            <span class="rail-nav-label">Providers</span>
        </a>
        <a class="rail-nav-item" href="https://github.com/konradcinkusz/agent-helm/issues" target="_blank" rel="noopener noreferrer" title="Feedback">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22V4a1 1 0 0 1 1-1h11l-2 4 2 4H5" /></svg>
            <span class="rail-nav-label">Feedback</span>
        </a>
    </footer>
</aside>
