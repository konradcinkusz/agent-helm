<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The ONLY NuGet dependency, mirroring the CopilotScope pattern. -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentHelm.Tests" />
  </ItemGroup>
  <!-- Inside the single-file build (AgentHelmSingleFile, set by scripts/build-single-file.sh) the
       App embeds this file itself; publishing it too would clash with Web's appsettings.json. -->
  <ItemGroup Condition="'$(AgentHelmSingleFile)' == 'true'">
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
