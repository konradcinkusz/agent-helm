<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The executable's name in the single-file build: agenthelm / agenthelm.exe. -->
    <AssemblyName>agenthelm</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Single-file (passed by scripts/build-single-file.sh): native libraries go inside the
         file and are extracted on first run; the bundle is compressed. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The three projects are executables. Referenced from a self-contained publish they must be
         self-contained too (NETSDK1151), so the flag is passed on explicitly. -->
    <ProjectReference Include="..\AgentHelm.Bridge\AgentHelm.Bridge.csproj" AdditionalProperties="SelfContained=$(SelfContained)" />
    <ProjectReference Include="..\AgentHelm.Web\AgentHelm.Web.csproj" AdditionalProperties="SelfContained=$(SelfContained)" />
    <ProjectReference Include="..\..\tools\AgentHelm.EchoAgent\AgentHelm.EchoAgent.csproj" AdditionalProperties="SelfContained=$(SelfContained)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Everything the single file needs is embedded: the Bridge's catalog and the UI's wwwroot
         (served by EmbeddedWebRoot, so nothing has to sit next to the executable). -->
    <EmbeddedResource Include="..\AgentHelm.Bridge\appsettings.json" LogicalName="bridge-appsettings.json" />
    <EmbeddedResource Include="..\AgentHelm.Web\wwwroot\**" LogicalName="wwwroot/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- AgentHelm.Web.styles.css (the scoped CSS bundle) is generated by the Razor build of the Web
       project into its obj folder. The Web project is built before this target runs, because it
       is a project reference. Embedded under the same wwwroot/ name as the other UI files. -->
  <!-- The bundle's exact folder inside obj is not fixed (it moved between SDK versions), so match
       the file name anywhere under the Web project. Its build output is the only match. -->
  <!-- Before PrepareResources, so the item goes through the normal resource handling; added any
       later (just before CoreCompile) it did not reach the assembly. -->
  <Target Name="EmbedWebScopedCss" BeforeTargets="PrepareResources">
    <ItemGroup>
      <_WebScopedCss Include="..\AgentHelm.Web\obj\**\AgentHelm.Web.styles.css" />
      <EmbeddedResource Include="@(_WebScopedCss)" LogicalName="wwwroot/AgentHelm.Web.styles.css" />
    </ItemGroup>
    <Message Importance="high" Text="Embedding scoped CSS bundle(s): @(_WebScopedCss)" />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentHelm.Tests" />
  </ItemGroup>
</Project>
